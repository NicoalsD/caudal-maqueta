<mxfile host="drawio"><diagram name="Conexiones UNO" id="uno"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1420" pageHeight="910" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Maqueta CAUDAL con Arduino UNO: conexiones&lt;/b&gt; (los colores son los de los cables reales)" style="html=1;whiteSpace=wrap;text;fontSize=22;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Computador&lt;/b&gt;&lt;br&gt;caudal-sim maqueta-usb&lt;br&gt;(firma y habla con la API)" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="190" height="100" as="geometry"/></mxCell><mxCell id="c4" value="" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#0D47A1;strokeColor=#082c66;" vertex="1" parent="1"><mxGeometry x="300" y="150" width="260" height="330" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Arduino UNO&lt;/b&gt;&lt;br&gt;firmware caudal_uno" style="html=1;whiteSpace=wrap;text;fontColor=#ffffff;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="300" width="200" height="60" as="geometry"/></mxCell><mxCell id="c6" value="D9" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#333333;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="190" width="60" height="26" as="geometry"/></mxCell><mxCell id="c7" value="D8" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#333333;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="240" width="60" height="26" as="geometry"/></mxCell><mxCell id="c8" value="D10" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#333333;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="390" width="60" height="26" as="geometry