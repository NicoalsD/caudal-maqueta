c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=3;strokeColor=#8B4513;jumpStyle=arc;jumpSize=12;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c37" target="c55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="C 470–1000 µF&lt;br&gt;(opcional, + arriba)" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#FFF8E1;strokeColor=#795548;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="615" width="110" height="30" as="geometry"/></mxCell><mxCell id="c59" value="" style="ellipse;fillColor=#D32F2F;strokeColor=#D32F2F;" vertex="1" parent="1"><mxGeometry x="449" y="594" width="12" height="12" as="geometry"/></mxCell><mxCell id="c60" value="" style="ellipse;fillColor=#222222;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="449" y="654" width="12" height="12" as="geometry"/></mxCell><mxCell id="c61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=2;strokeColor=#D32F2F;jumpStyle=arc;jumpSize=12;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c58" target="c59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=2;strokeColor=#222222;jumpStyle=arc;jumpSize=12;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c58" target="c60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c63" value="&lt;b&gt;Tabla de conexiones&lt;/b&gt;&lt;br&gt;HC-SR04: Vcc (café) → riel +5 V · Trig (naranja) → D9 · Echo (amarillo) → D8 · Gnd (rojo) → riel GND&lt;br&gt;Servo 1: señal (naranja) → D10 · rojo → riel +5 V · café → riel GND &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; Servo 2: señal (naranja) → D11 · rojo → riel +5 V · café → riel GND&lt;br&gt;Arduino: 5V → riel +5 V · GND → riel GND · USB → computador&lt;br&gt;&lt;br&gt;&lt;b&gt;Alimentación:&lt;/b&gt; sin fuente externa. Todo sale del USB del Arduino (unos 500 mA) por los rieles de la protoboard. El firmware mueve un servo a la vez y despacio para no pasarse.&lt;br&gt;Si el Arduino se reinicia al mover un servo: ajusta el ángulo cerrado para que no fuerce la manguera y, si tienes uno, pon el condensador entre los rieles.&lt;br&gt;&lt;b&gt;Protoboard:&lt;/b&gt; usa solo la mitad izquierda (columnas 1 a 30): los rieles están cortados a la mitad. El montaje paso a paso está en maqueta-uno-protoboard.png.&lt;br&gt;&lt;b&gt;Sensor:&lt;/b&gt; el agua llena debe quedar a 3 cm o más del HC-SR04 (zona ciega)." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="720" width="1390" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>