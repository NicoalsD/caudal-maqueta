<mxCell id="e5" value="HTTPS&lt;br&gt;firmado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#336666;startArrow=classic;fontSize=11;" edge="1" source="hot" target="back" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" value="API con&lt;br&gt;sesión" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#336666;startArrow=classic;fontSize=11;" edge="1" source="app" target="back" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n1" value="&lt;b&gt;Ver el nivel&lt;/b&gt;&lt;br&gt;1. El ESP32 calcula: nivel = distancia con el tanque vacío - distancia medida.&lt;br&gt;2. Cada 20 s envía el nivel con POST /api/v1/devices/telemetry.&lt;br&gt;3. La app muestra el nivel y la posición de cada llave." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f4f9f9;strokeColor=#669999;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="640" height="120" as="geometry"/></mxCell>
<mxCell id="n2" value="&lt;b&gt;Abrir o cerrar una llave&lt;/b&gt;&lt;br&gt;4. Un usuario autorizado, o el piloto, ordena el cambio y el backend crea un comando.&lt;br&gt;5. Cada 1,2 s, cada llave consulta GET /api/v1/devices/commands.&lt;br&gt;6. El ESP32 mueve el servo y confirma con POST /api/v1/devices/commands/{id}/ack." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f4f9f9;strokeColor=#669999;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="610" width="660" height="120" as="geometry"/></mxCell>
<mxCell id="n3" value="Línea punteada del servidor: aún no está desplegado. El firmware actual controla relés; pasar a servos y HC-SR04 requiere el cambio de valve_driver y de los parámetros del sensor." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="745" width="1320" height="40" as="geometry"/></mxCell>
